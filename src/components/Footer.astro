---
import type { Dict } from '../i18n/ar';
import { site } from '../config';
import Brand from './Brand.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__col">
      <Brand size={26} />
      <p class="footer__tagline">{t.footer.tagline}</p>
    </div>

    <div class="footer__col footer__col--end">
      <span class="footer__label">{t.footer.contact}</span>
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </div>
  </div>

  <div class="wrap footer__legal">
    <!-- The year is isolated: inside an Arabic sentence the bidi algorithm
         would otherwise reorder "Lexi 2026" into "2026 Lexi". -->
    <span>© <span class="q">{year}</span> Lexi. {t.footer.rights}</span>
  </div>
</footer>

<style>
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer__col--end {
    align-items: flex-start;
  }

  .footer__tagline {
    max-width: 42ch;
    color: var(--text-tertiary);
  }

  .footer__label {
    color: var(--text-tertiary);
    font-size: 13.5px;
  }

  .footer__legal {
    margin-block-start: 36px;
    padding-block-start: 22px;
    border-block-start: 1px solid rgba(240, 237, 230, 0.08);
    color: var(--text-tertiary);
    font-size: 13.5px;
  }
</style>
