---
/**
 * The Seal -- the same PNG the desktop app ships, not a redrawing of it. A
 * visitor who installs the product has to recognise the icon in their taskbar as
 * the one they saw on this page, and two hand-maintained copies of a mark drift.
 * Regenerated by `lexi/scripts/extract-brand-png.py`; see lexi/docs/DESIGN.md.
 *
 * `surface` picks which extraction to use. Both files are gold on transparency,
 * so they look the same anywhere -- the difference is edge quality, and each is
 * cleanest against the background it was keyed from. Every current usage (nav,
 * footer) sits on navy, hence the default.
 *
 * Cormorant Garamond is not bundled (no CDN imports), so the wordmark falls
 * back to Georgia -- also a serif with a high-contrast axis, which keeps the
 * character even when the exact face is missing.
 */
interface Props {
  size?: number;
  wordmark?: boolean;
  surface?: 'dark' | 'light';
}
const { size = 28, wordmark = true, surface = 'dark' } = Astro.props;
---

<span class="brand">
  <img
    class="brand__mark"
    src={`/brand/seal-${surface}-128.png`}
    width={size}
    height={size}
    alt=""
    aria-hidden="true"
    decoding="async"
  />
  {wordmark && <span class="brand__word">Lexi</span>}
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .brand__mark {
    flex: none;
    display: block;
  }

  /* The wordmark stays Latin and LTR in both languages: it is a name, and
     "Lexi" reversed by the bidi algorithm inside an Arabic sentence would not
     be the product's name any more. */
  .brand__word {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 0.05em;
    direction: ltr;
    unicode-bidi: isolate;
  }
</style>
