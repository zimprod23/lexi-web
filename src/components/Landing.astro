---
import type { Dict } from '../i18n/ar';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import AppFrame from './AppFrame.astro';
import DownloadPanel from './DownloadPanel.astro';
import RequestForm from './RequestForm.astro';
import VideoSection from './VideoSection.astro';
import Zellige from './Zellige.astro';
import { demoVideo } from '../config';

/**
 * The whole page, once. The two routes differ only by the dictionary they hand
 * in -- duplicating this markup per language is how one of them quietly stops
 * getting fixes.
 */
interface Props {
  t: Dict;
  home: string;
  thanksHref: string;
}
const { t, home, thanksHref } = Astro.props;
---

<Nav t={t} home={home} />

<main id="main">
  <!-- ── Hero ───────────────────────────────────────────────────── -->
  <section class="tile tile--dark hero">
    <Zellige id="z-hero" size={132} opacity={0.05} fade="top" />
    <div class="hero__aura" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <p class="eyebrow" data-reveal style="--i:0">{t.hero.eyebrow}</p>
      <h1 class="display hero__title" data-reveal style="--i:1">{t.hero.title}</h1>
      <p class="lead" data-reveal style="--i:2">{t.hero.lead}</p>
      <div class="btn-row" data-reveal style="--i:3">
        <a class="btn btn--primary" href="#request">{t.hero.primary}</a>
        {/* Points at the video when there is one to point at, and at the
            feature cards otherwise -- the promise the button makes has to be
            one the page can keep. */}
        <a class="btn btn--ghost" href={demoVideo ? '#video' : '#features'}>{t.hero.secondary}</a>
      </div>
      <p class="fine hero__reassure" data-reveal style="--i:4">{t.hero.reassure}</p>
    </div>
  </section>

  <!-- ── The three facts, then what it does ─────────────────────── -->
  <section class="tile tile--paper" id="features">
    <div class="wrap">
      <ul class="strip">
        {
          t.strip.map((item, i) => (
            <li class="strip__item" data-reveal style={`--i:${i}`}>
              <span class="strip__mark" aria-hidden="true">
                <Icon name="check" />
              </span>
              <div>
                <h3 class="strip__title">{item.title}</h3>
                <p class="strip__body">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.features.eyebrow}</p>
        <h2 class="display--sm">{t.features.title}</h2>
      </div>

      <div class="grid grid--2">
        {
          t.features.items.map((item, i) => (
            <article class="card" data-reveal style={`--i:${i % 2}`}>
              <span class="plate">
                <Icon name={item.icon} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── The demo video, when one exists ────────────────────────── -->
  <VideoSection t={t} />

  <!-- ── Inside the product ─────────────────────────────────────── -->
  <section class="tile tile--dark-2">
    <Zellige id="z-showcase" size={150} opacity={0.038} fade="bottom" />
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.showcase.eyebrow}</p>
      </div>

      {
        t.showcase.items.map((item, i) => (
          /* The two halves arrive from opposite edges and meet. Which edge
             swaps with the row, so the motion always closes toward the centre
             rather than the pair sliding across each other. */
          <div class:list={['show', i % 2 === 1 && 'show--flip']}>
            <div class="show__text" data-reveal={i % 2 === 1 ? 'end' : 'start'}>
              <h3 class="display--sm">{item.title}</h3>
              <p class="prose">{item.body}</p>
            </div>
            <div class="show__media" data-reveal={i % 2 === 1 ? 'start' : 'end'} style="--i:1">
              <AppFrame src={item.shot} alt={item.title} caption={item.caption} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── How it works ───────────────────────────────────────────── -->
  <section class="tile tile--parchment" id="how">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2 class="display--sm">{t.how.title}</h2>
      </div>

      <ol class="steps">
        {
          t.how.steps.map((step, i) => (
            <li class="step" data-reveal style={`--i:${i}`}>
              <span class="step__num q">{i + 1}</span>
              <h3 class="step__title">{step.title}</h3>
              <p class="step__body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── Privacy ────────────────────────────────────────────────── -->
  <section class="tile tile--dark">
    <div class="wrap privacy">
      <div data-reveal>
        <span class="plate">
          <Icon name="shield" />
        </span>
        <p class="eyebrow">{t.privacy.eyebrow}</p>
        <h2 class="display--sm privacy__title">{t.privacy.title}</h2>
      </div>
      <div data-reveal style="--i:1">
        <p class="prose">{t.privacy.body}</p>
        <ul class="ticks">
          {
            t.privacy.points.map((point) => (
              <li>
                <Icon name="check" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Requirements ───────────────────────────────────────────── -->
  <section class="tile tile--paper" id="requirements">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.requirements.eyebrow}</p>
        <h2 class="display--sm">{t.requirements.title}</h2>
        <p class="lead">{t.requirements.lead}</p>
      </div>

      <dl class="specs" data-reveal>
        {
          t.requirements.rows.map((row) => (
            <div class="specs__row">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="fine specs__note" data-reveal>{t.requirements.note}</p>
    </div>
  </section>

  <!-- ── Download ───────────────────────────────────────────────── -->
  <section class="tile tile--dark-2" id="download">
    <div class="wrap download" data-reveal>
      <p class="eyebrow">{t.download.eyebrow}</p>
      <DownloadPanel t={t} requestHref="#request" />
    </div>
  </section>

  <!-- ── Request a licence ──────────────────────────────────────── -->
  <section class="tile tile--parchment" id="request">
    <div class="wrap request">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.form.eyebrow}</p>
        <h2 class="display--sm">{t.form.title}</h2>
        <p class="lead">{t.form.lead}</p>
      </div>
      <div data-reveal style="--i:1">
        <RequestForm t={t} thanksHref={thanksHref} />
      </div>
    </div>
  </section>
</main>

<Footer t={t} />

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 13vw, 140px);
  }

  /* DESIGN.md forbids decorative gradients because photography supplies the
     atmosphere. There is no photography yet, and a flat navy slab under the
     first headline reads as unfinished rather than restrained -- so exactly one
     gradient exists, it is the brand gold at 10%, and it goes when a real hero
     image lands. */
  .hero__aura {
    position: absolute;
    inset-block-start: -30%;
    inset-inline-end: -10%;
    inline-size: min(760px, 90vw);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.10), transparent 62%);
    pointer-events: none;
    animation: drift 22s var(--ease) infinite alternate;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-4%, 5%, 0) scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__aura {
      animation: none;
    }
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }

  .hero__title {
    max-width: 17ch;
  }

  .hero__reassure {
    max-width: 52ch;
    margin-block-start: 6px;
  }

  /* ── Section heads ────────────────────────────────────────────── */
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 46ch;
    margin-block-end: clamp(32px, 5vw, 52px);
  }

  /* ── Fact strip ───────────────────────────────────────────────── */
  .strip {
    list-style: none;
    padding: 0;
    margin: 0 0 clamp(48px, 7vw, 80px);
    display: grid;
    gap: 24px;
    padding-block-end: clamp(40px, 6vw, 64px);
    border-block-end: 1px solid var(--hairline);
  }

  @media (min-width: 760px) {
    .strip {
      grid-template-columns: repeat(3, 1fr);
      gap: 36px;
    }
  }

  .strip__item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .strip__mark {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 26px;
    block-size: 26px;
    border-radius: 50%;
    background: var(--gold-faint);
    color: var(--gold-deep);
    margin-block-start: 3px;
  }

  .strip__title {
    font-size: 18px;
    margin-block-end: 4px;
  }

  .strip__body {
    color: var(--ink-muted);
    font-size: 16px;
  }

  /* ── Showcase ─────────────────────────────────────────────────── */
  .show {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    padding-block: clamp(32px, 5vw, 56px);
  }

  @media (min-width: 900px) {
    .show {
      grid-template-columns: 1fr 1.15fr;
    }
    /* The frame leads on alternate rows. `order` rather than a reversed grid
       definition, so the DOM order stays text-then-image in both directions
       and a screen reader hears the explanation before the illustration. */
    .show--flip .show__text {
      order: 2;
    }
  }

  .show__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ── Steps ────────────────────────────────────────────────────── */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(22px, 3vw, 34px);
    counter-reset: step;
  }

  @media (min-width: 820px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* The gold rule draws itself when the step arrives, from the reading edge
     outward: left in French, right in Arabic. `transform-origin` takes no
     logical keyword, so --flip resolves it arithmetically -- 0% when --flip is
     1, 100% when it is -1. */
  .step {
    position: relative;
    padding-block-start: 22px;
  }

  .step::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 2px;
    background: var(--gold);
    transform-origin: calc(50% - 50% * var(--flip)) center;
  }

  /* Scoped stylesheets cannot see the class on <html>, hence :global. Without
     JavaScript the rule is simply drawn, like any border. */
  :global(.js-reveal) .step::before {
    transform: scaleX(0);
    transition: transform 700ms var(--ease);
    transition-delay: calc(var(--i, 0) * 55ms + 140ms);
  }

  :global(.js-reveal) .step.is-in::before {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js-reveal) .step::before {
      transform: scaleX(1);
      transition: none;
    }
  }

  .step__num {
    font-size: 14px;
    font-weight: 700;
    color: var(--gold-deep);
  }

  .step__title {
    font-size: 21px;
    margin-block: 8px 10px;
  }

  .step__body {
    color: var(--ink-muted);
    font-size: 16px;
  }

  /* ── Privacy ──────────────────────────────────────────────────── */
  .privacy {
    display: grid;
    gap: clamp(26px, 4vw, 56px);
  }

  @media (min-width: 900px) {
    .privacy {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .privacy__title {
    margin-block-start: 12px;
  }

  .ticks {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ticks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: var(--text-primary);
    font-size: 16px;
  }

  /* ── Requirements ─────────────────────────────────────────────── */
  .specs {
    margin: 0;
    border-block-start: 1px solid var(--hairline);
  }

  .specs__row {
    display: grid;
    gap: 4px 32px;
    padding-block: 18px;
    border-block-end: 1px solid var(--hairline);
  }

  @media (min-width: 640px) {
    .specs__row {
      grid-template-columns: 200px 1fr;
      align-items: baseline;
    }
  }

  .specs__row dt {
    color: var(--ink-faint);
    font-size: 15px;
  }

  .specs__row dd {
    margin: 0;
    font-weight: 600;
  }

  .specs__note {
    margin-block-start: 22px;
    max-width: var(--measure);
  }

  /* ── Download + request ───────────────────────────────────────── */
  .download {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 760px;
  }

  .request {
    max-width: 860px;
  }
</style>
