---
import type { Dict } from '../i18n/ar';
import { site } from '../config';
import '../styles/global.css';

interface Props {
  t: Dict;
  title?: string;
  description?: string;
  /** Path of this page in the OTHER language, for hreflang + canonical. */
  altPath: string;
  path: string;
  /**
   * JSON-LD graph for this page, or nothing.
   *
   * Opt-in rather than automatic, because the thank-you pages are `noindex`
   * and describing a page to a crawler that has been told not to index it is
   * a contradiction the crawler has to resolve.
   */
  schema?: object;
}

const { t, title, description, altPath, path, schema } = Astro.props;
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(path, site.url).href;
const alternate = new URL(altPath, site.url).href;
const altLang = t.htmlLang === 'ar' ? 'fr' : 'ar';
---

<!doctype html>
<html lang={t.htmlLang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />

    <!-- Both languages are first-class URLs, so each one has to declare the
         other. x-default points at Arabic: it is the audience's language, and
         the desktop app makes the same choice. -->
    <link rel="alternate" hreflang={t.htmlLang} href={canonical} />
    <link rel="alternate" hreflang={altLang} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site.url).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.localeTag.replace('-', '_')} />
    <!-- `summary_large_image` was declared with no image to show, so every share
         of this site previewed as a blank card — the one thing a person sees
         before deciding whether to click. The card is deliberately
         language-neutral (mark, name, domain, no sentence): both languages are
         real URLs, and an Arabic card on the French page would be worse than no
         words. Regenerate with scripts/make-og-image.py. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={new URL('/og.png', site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lexi — lexiarchive.com" />
    <meta name="twitter:image" content={new URL('/og.png', site.url).href} />

    {
      /* Typed facts for search engines and for the answer engines that quote
         this site without ever sending a visitor to it. `set:html` with
         JSON.stringify, never a template literal: an apostrophe in the French
         copy has to reach the crawler as valid JSON. */
    }
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}

    <meta name="theme-color" content="#0B1422" />
    <!-- Monogram at tab sizes, Seal above: the Seal is an octagon *plus* an
         internal figure, and at 16px that closes into a circle with two blobs.
         Measured — see lexi/docs/DESIGN.md → Brand assets. -->
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/monogram-dark-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/monogram-dark-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/brand/monogram-dark-64.png" />
    <link rel="icon" type="image/png" sizes="128x128" href="/brand/seal-dark-128.png" />
    <link rel="apple-touch-icon" href="/brand/seal-dark-256.png" />

    <!-- Runs before first paint so the reveal system's hidden state is applied
         in the same frame the markup lands. Doing it from the deferred script
         at the end of <body> would show every section, then hide it, then
         animate it back in -- a visible flash of the whole page. -->
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>

  <body>
    <!-- Reading progress. Pure CSS (scroll-driven), hidden entirely where
         scroll timelines are unsupported or motion is reduced. -->
    <div class="progress" aria-hidden="true"></div>
    <a class="skip" href="#main">{t.nav.home}</a>
    <slot />

    <script is:inline>
      (function () {
        var nodes = document.querySelectorAll('[data-reveal]');
        // No observer (or no JS at all) must not mean no content: drop the
        // class the hidden state hangs off and the page is simply static.
        if (!('IntersectionObserver' in window)) {
          document.documentElement.classList.remove('js-reveal');
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('is-in');
                io.unobserve(entries[i].target);
              }
            }
          },
          // A positive bottom margin grows the root box, so a section starts
          // animating just before it is scrolled into view and has finished by
          // the time it is actually being read. A negative value here (the
          // instinctive choice) does the opposite and is what made fast
          // scrolling land on empty sections.
          { rootMargin: '0px 0px 10% 0px', threshold: 0.02 }
        );
        for (var i = 0; i < nodes.length; i++) io.observe(nodes[i]);
      })();
    </script>

    <style is:global>
      .skip {
        position: absolute;
        inset-block-start: -60px;
        inset-inline-start: 12px;
        z-index: 100;
        background: var(--gold);
        color: var(--bg-0);
        padding: 10px 18px;
        border-radius: var(--r-pill);
        text-decoration: none;
        font-weight: 600;
        transition: inset-block-start 160ms var(--ease);
      }
      .skip:focus {
        inset-block-start: 12px;
      }
    </style>
  </body>
</html>
